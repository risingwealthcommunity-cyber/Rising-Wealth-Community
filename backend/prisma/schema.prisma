generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Package {
  TRAINEE
  PRO
  ELITE
}

enum Leg {
  LEFT
  RIGHT
}

enum Rank {
  NONE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  BLUE_DIAMOND
  BLACK_DIAMOND
  ROYAL_DIAMOND
  CROWN
  DOUBLE_CROWN
  TRIPLE_CROWN
  IMPERIAL
  IMPERIAL_PLUS
  LEGACY
  LEGACY_PLUS
  DYNASTY
  ETERNAL
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String? // null for Google-only accounts
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?

  // Plan: every user starts as TRAINEE (no package)
  package Package @default(TRAINEE)
  rank    Rank    @default(NONE)

  // Referral (sponsor) tree: who invited me
  referralCode String  @unique
  /// Two unique sponsor codes per member: joining with one places the new member on that leg of this member.
  leftCode     String?  @unique
  rightCode    String?  @unique
  sponsorId    String?
  sponsor      User?   @relation("Sponsor", fields: [sponsorId], references: [id])
  referrals    User[]  @relation("Sponsor")

  // Binary tree (placement): who is my parent and on which leg
  parentId String?
  parent   User?   @relation("Binary", fields: [parentId], references: [id])
  children User[]  @relation("Binary")
  leg      Leg?

  // Team Performance Bonus (2:2, 4:4, ...): NEW members not yet used up by a completed target, plus lifetime totals.
  teamLeftNew     Float @default(0)
  teamRightNew    Float @default(0)
  teamLeftTotal   Int @default(0)
  teamRightTotal  Int @default(0)
  teamTargetsDone Int @default(0)

  // Leadership Bonus: 1 point per new member sponsored by one of my direct referrals (cumulative, never reset).
  leadershipPoints      Float @default(0)
  leadershipTargetsDone Int @default(0)

  // Auth (same model as the NGO system)
  isVerified           Boolean   @default(false)
  emailVerifyTokenHash String?
  emailVerifyExpiry    DateTime?
  googleId             String?   @unique
  photoUrl             String?
  /// Key of one of the preset avatars the member picked (a1..a12). Null = show initials.
  avatar               String?
  twoFactorOtpHash     String?
  twoFactorOtpExpiry   DateTime?
  twoFactorAttempts     Int       @default(0)
  /// 6-digit alternatives to the emailed links. Only an HMAC of the code is stored, with a wrong-guess counter.
  emailVerifyCodeHash     String?
  emailVerifyCodeExpiry   DateTime?
  emailVerifyCodeAttempts Int       @default(0)
  resetCodeHash           String?
  resetCodeExpiry         DateTime?
  resetCodeAttempts       Int       @default(0)
  refreshTokenHash     String?
  resetPasswordTokenHash String?
  resetPasswordExpiry    DateTime?

  // Chosen at signup; the user is placed in the binary tree when the email is verified.
  preferredLeg Leg?

  // Wallet (rupees, 2 decimals)
  walletBalance Decimal @default(0) @db.Decimal(14, 2)
  /// Money that can only be spent on activating / upgrading IDs. Filled by approved fund requests or a transfer from the wallet.
  activationBalance Decimal @default(0) @db.Decimal(14, 2)

  /// Separate password that must be typed to move money. Wrong guesses lock it for a while.
  txnPasswordHash   String?
  txnFailedAttempts Int       @default(0)
  /// Withdrawals and bank changes stay paused for 24 hours after this, so a stolen session cannot cash out at once.
  txnPasswordChangedAt DateTime?
  /// One-time emailed link that lets the member choose a new transaction password.
  txnResetTokenHash String?
  txnResetExpiry    DateTime?
  txnLockedUntil    DateTime?

  city String?

  // Binary points in HALF-points (PRO = 0.5 => 1, ELITE = 1 => 2).
  // rank*  : "new points" for the next rank, reset to 0 on every rank-up.
  // match* : unmatched points for the Leadership Bonus, consumed when matched.
  rankLeftHalf  Int @default(0)
  rankRightHalf Int @default(0)
  matchLeftHalf  Int @default(0)
  matchRightHalf Int @default(0)

  purchases      PackagePurchase[]
  ledger         LedgerEntry[]      @relation("LedgerOwner")
  ledgerSources  LedgerEntry[]      @relation("LedgerSource")
  dematReferrals DematReferral[]
  activationEntries ActivationEntry[]
  fundRequests      FundRequest[]
  withdrawals       WithdrawalRequest[]
  holds             WalletHold[] @relation("WalletHolds")
  pendingBonuses    PendingBonus[] @relation("PendingBonuses")
  bankDetails       BankDetails?
  campaignReports   CampaignReport[]
  perkClaims        PerkClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Only one child per leg under a parent
  @@unique([parentId, leg])
  @@index([sponsorId])
}

enum PurchaseStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum LedgerType {
  DIRECT_INCOME
  PASSIVE_INCOME
  DEMAT_DIRECT
  DEMAT_PASSIVE
  WEEKLY_BONUS
  PERFORMANCE_BONUS
  LEADERSHIP_BONUS
  TEAM_PERFORMANCE_BONUS
  LEADERSHIP_TARGET_BONUS
  RANK_REWARD
  CAMPAIGN_REWARD
  /// A monthly royalty an admin credits to a member.
  MONTHLY_ROYALTY
  /// Negative rows: money leaving the wallet.
  WITHDRAWAL
  WALLET_TRANSFER
  /// An admin took money out of a member's wallet (the reason is in the note).
  ADMIN_DEDUCTION
  COMPANY_FUND
}

/// A bonus a member has earned that waits for an admin to press Release, and only then reaches their wallet.
model PendingBonus {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation("PendingBonuses", fields: [userId], references: [id])
  type         LedgerType
  level        Int?
  amount       Decimal    @db.Decimal(14, 2)
  sourceUserId String?
  periodId     String?
  note         String?
  createdAt    DateTime   @default(now())
  releasedAt   DateTime?
  releasedBy   String?

  @@index([releasedAt, type])
  @@index([userId])
}

/// Money an admin has put on hold in a member's wallet: it stays in the wallet but cannot be withdrawn or moved until released.
model WalletHold {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation("WalletHolds", fields: [userId], references: [id])
  amount     Decimal   @db.Decimal(14, 2)
  reason     String
  createdBy  String
  createdAt  DateTime  @default(now())
  releasedAt DateTime?
  releasedBy String?

  @@index([userId, releasedAt])
}

model PackagePurchase {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  package     Package
  amount      Decimal        @db.Decimal(14, 2)
  status      PurchaseStatus @default(PENDING)
  reference   String? // payment reference / UTR entered by user
  /// true = the member asked to pay with their activation wallet: the price is taken from it when an admin approves.
  paidFromWallet Boolean     @default(false)
  /// The payment screenshot the member sent (kept in the database, compressed in the browser).
  fileName    String?
  fileMime    String?
  fileData    Bytes?
  createdAt   DateTime       @default(now())
  confirmedAt DateTime?
  confirmedBy String?

  @@index([userId])
  @@index([status, confirmedAt])
}

/// Every rupee movement. userId = null means the COMPANY fund.
model LedgerEntry {
  id           String     @id @default(uuid())
  userId       String?
  user         User?      @relation("LedgerOwner", fields: [userId], references: [id])
  type         LedgerType
  amount       Decimal    @db.Decimal(14, 2)
  level        Int?
  sourceUserId String?
  sourceUser   User?      @relation("LedgerSource", fields: [sourceUserId], references: [id])
  purchaseId   String?
  periodId     String?
  note         String?
  createdAt    DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([type])
}

model DematReferral {
  id           String   @id @default(uuid())
  referrerId   String
  referrer     User     @relation(fields: [referrerId], references: [id])
  clientName   String?
  directAmount Decimal  @db.Decimal(14, 2)
  note         String?
  createdBy    String
  createdAt    DateTime @default(now())

  @@index([referrerId])
}

/// One closed payout window (weekly). Pools are a % of confirmed package revenue in the window.
model PayoutPeriod {
  id               String   @id @default(uuid())
  startsAt         DateTime @unique
  endsAt           DateTime
  revenue          Decimal  @db.Decimal(14, 2)
  weeklyPool       Decimal  @db.Decimal(14, 2)
  performancePool  Decimal  @db.Decimal(14, 2)
  leadershipPool   Decimal  @db.Decimal(14, 2)
  weeklyPaid       Decimal  @db.Decimal(14, 2)
  performancePaid  Decimal  @db.Decimal(14, 2)
  leadershipPaid   Decimal  @db.Decimal(14, 2)
  closedBy         String
  createdAt        DateTime @default(now())
}

/// Admin-managed site images (About photo, registration certificate). Stored in the database
/// so they survive redeploys without a separate file store.
model SiteAsset {
  key       String   @id
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt
}

/// Admin-editable content blocks for the public site (milestones, team, reviews, contact).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Campaign reports only: the proof is not enough, the member can fix and resend it.
  INCOMPLETE
  /// Campaign reports only: the account could not be found.
  MISSING
  /// Campaign reports only: that account was already registered before.
  ALREADY_EXISTING
}

enum ActivationKind {
  FUND_ADDED
  TRANSFER_IN
  SPEND
}

/// Every movement of the activation wallet (signed amount). activationBalance = the sum of a member's rows.
model ActivationEntry {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  kind      ActivationKind
  amount    Decimal        @db.Decimal(14, 2)
  note      String?
  createdAt DateTime       @default(now())

  @@index([userId, createdAt])
}

/// "I paid this much, here is the bank reference": an admin checks it and credits the activation wallet.
model FundRequest {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  amount      Decimal       @db.Decimal(14, 2)
  reference   String
  /// The payment screenshot the member sent (kept in the database, compressed in the browser).
  fileName    String?
  fileMime    String?
  fileData    Bytes?
  status      RequestStatus @default(PENDING)
  note        String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?
  processedBy String?

  @@index([userId])
  @@index([status, createdAt])
}

/// The wallet is only debited when an admin approves (and pays) the request.
model WithdrawalRequest {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  amount      Decimal       @db.Decimal(14, 2)
  status      RequestStatus @default(PENDING)
  note        String?
  /// Still waiting for the payment, but an admin has started on it (shown to the member as "Processing").
  inProgress  Boolean       @default(false)
  /// Filled in by the admin who paid it: the bank transaction ID and a screenshot of the payment.
  payoutRef   String?
  fileName    String?
  fileMime    String?
  fileData    Bytes?
  createdAt   DateTime      @default(now())
  processedAt DateTime?
  processedBy String?

  @@index([userId])
  @@index([status, createdAt])
}

/// Payout details. The account number is stored encrypted.
model BankDetails {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id])
  bankName   String
  accountEnc String
  ifsc       String
  upiId      String
  updatedAt  DateTime @updatedAt
}

/// Something members can promote for a reward (for example a Demat account opening).
model Campaign {
  id          String   @id @default(uuid())
  title       String
  description String
  reward      Decimal  @db.Decimal(14, 2)
  /// The link members share (or open).
  url         String
  videoUrl    String
  /// true = a member submits a proof report that an admin approves before the reward is paid.
  needsProof  Boolean  @default(true)
  /// true = a Demat account opening: approving a report runs the Demat referral plan (direct income + 5 passive levels).
  isDemat     Boolean  @default(false)
  /// Optional label to group campaigns (for example "summer_promo_2024").
  groupName   String   @default("")
  /// STANDARD: everyone shares the same link. PERSONAL: the member's Affiliate ID is added to the link.
  linkType    String   @default("STANDARD")
  /// true = Live. false = Expired: members still see it for 30 days, marked Expired, and cannot send reports.
  isActive    Boolean  @default(true)
  expiredAt   DateTime?
  /// true = members can still send reports for this campaign even after it has expired.
  reportsOpen Boolean  @default(false)
  createdAt   DateTime @default(now())

  reports CampaignReport[]
}

model CampaignReport {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  campaignId  String
  campaign    Campaign      @relation(fields: [campaignId], references: [id])
  holderName  String
  mobile      String
  /// A campaign that does not require documents can be reported without a screenshot.
  fileName    String?
  fileMime    String?
  fileData    Bytes?
  status      RequestStatus @default(PENDING)
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  processedAt DateTime?
  processedBy String?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([campaignId])
}

/// A member asking for the perk (bike, trip, ...) of a rank they have reached. One claim per rank.
model PerkClaim {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  rank        Rank
  status      RequestStatus @default(PENDING)
  note        String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?
  processedBy String?

  @@unique([userId, rank])
  @@index([status, createdAt])
}

/// A live training: when it happens, the join link, and the lowest package that may join.
model LiveSession {
  id          String   @id @default(uuid())
  title       String
  description String
  startsAt    DateTime
  link        String
  minTier     Package  @default(TRAINEE)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([startsAt])
}

/// A message from the contact form on the landing page.
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  whatsapp  String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
