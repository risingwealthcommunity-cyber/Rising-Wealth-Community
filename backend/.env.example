NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:password@localhost:5432/rwc"
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-32-plus-chars
JWT_REFRESH_SECRET=change-me-to-another-random-string-32-plus

# Email (pick one). In development with none set, links are printed in the backend console.
BREVO_API_KEY=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=RWC

# Google login (optional). In dev the callback goes through the Vite proxy so cookies stay same-origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# Admin 2FA via emailed OTP (true/false)
ENABLE_ADMIN_2FA=false

# Used by `npm run seed`
ROOT_EMAIL=admin@rwc.local
ROOT_PASSWORD=Admin12345
