# Copy to deploy/.env on the server and fill every value. Never commit deploy/.env.
DOMAIN=app.yourdomain.com
DB_PASSWORD=
# make each with:  openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FIELD_ENCRYPTION_KEY=
ENABLE_ADMIN_2FA=true

# email (Brevo recommended) and Google login are optional
BREVO_API_KEY=
EMAIL_FROM_NAME=RWC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2
R2_ENDPOINT=
R2_BUCKET=rwc-uploads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# used once by the admin seed
ROOT_EMAIL=
ROOT_PASSWORD=

# optional: a ready member account for people shown the app (password at least 10 characters)
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
