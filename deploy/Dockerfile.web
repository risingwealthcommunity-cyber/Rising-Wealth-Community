# Frontend: builds the site, then serves it with Caddy (which also gets the HTTPS certificate and forwards /api to the backend).
FROM node:22-bookworm-slim AS build
WORKDIR /web
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npx vite build

FROM caddy:2
COPY --from=build /web/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
