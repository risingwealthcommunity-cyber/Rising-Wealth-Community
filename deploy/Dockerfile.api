# Backend: builds the TypeScript and runs it. Works on the free Oracle ARM (Ampere) and AMD machines.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci
COPY backend/ ./
RUN npx prisma generate && npx tsc
ENV NODE_ENV=production
EXPOSE 5000
# every start: create or update the tables, create the admin and the starting site text if ROOT_PASSWORD is set (both skip what already
# exists), then run the server
CMD ["sh", "-c", "npx prisma db push --skip-generate && if [ -n \"$ROOT_PASSWORD\" ]; then npx ts-node src/seed.ts && npx ts-node src/seed-site.ts && npx ts-node src/seed-demo-user.ts; fi; node dist/server.js"]
